@page "/history"
@inject HistoryService HistoryStore

<PageTitle>QueryRe — History</PageTitle>

<div class="page-title">
    <div>
        <span class="eyebrow">THIS APP SESSION</span>
        <h1>Question history</h1>
        <p>The latest 50 questions are kept in memory and reset when the app restarts.</p>
    </div>
    <button class="secondary" @onclick="Clear">Clear history</button>
</div>

@if (items.Count == 0)
{
    <div class="empty">No questions yet. Go to the Ask page and try one.</div>
}
else
{
    <div class="history-list">
        @foreach (QueryLog item in items)
        {
            <article>
                <div>
                    <b>@item.Question</b>
                    <span>@item.Time.ToString("dd MMM yyyy, HH:mm")</span>
                </div>
                <span class="status @(item.Success ? "good" : "bad")">
                    @(item.Success ? "Executed" : "Blocked/failed")
                </span>
                @if (!string.IsNullOrWhiteSpace(item.Sql))
                {
                    <code>@item.Sql</code>
                }
            </article>
        }
    </div>
}

@code {
    private List<QueryLog> items = new();

    protected override void OnInitialized() => items = HistoryStore.GetAll();

    private void Clear()
    {
        HistoryStore.Clear();
        items.Clear();
    }
}
